#!/bin/sh
# Runs the same checks as CI before a push leaves the machine.
# Install with `make hooks`. Skip once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"

# Nothing to check when only deleting remote branches.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) ;;
        *) pushing=1 ;;
    esac
done
[ "$pushing" = 1 ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: note: uncommitted changes are present; the checks run on the working tree, not on what is being pushed." >&2
fi

echo "pre-push: format and clippy (make lint)" >&2
make lint >/dev/null 2>&1 || {
    echo "pre-push: make lint failed. Run it to see why; 'make fmt' fixes formatting." >&2
    exit 1
}

echo "pre-push: tests (make unit)" >&2
log=$(mktemp)
if ! make unit >"$log" 2>&1; then
    grep -E "panicked|FAILED|failed|^error|left:|right:" "$log" | head -40 >&2
    echo "pre-push: make unit failed. Full output: $log" >&2
    exit 1
fi
rm -f "$log"
echo "pre-push: all checks passed" >&2
